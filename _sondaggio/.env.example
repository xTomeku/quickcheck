# Copia questo file in .env.local e inserisci i valori del tuo progetto Supabase
# (Project Settings > API). Usa solo la chiave pubblica (publishable), mai la secret.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# ID client OAuth di Google (Google Cloud → Google Auth Platform → Client). È pubblico per natura.
# Il Client secret non serve e non va mai scritto qui.
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
